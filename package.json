{
  "name": "cyber-academie-az",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plateforme d'apprentissage de la cybersécurité, de A à Z",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:site": "npm run build && rm -rf site && cp -a dist site",
    "typecheck": "tsc --noEmit",
    "sync:content": "python3 scripts/build_content.py --sync"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}
